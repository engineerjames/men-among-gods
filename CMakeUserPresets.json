{
    "version": 2,
    "configurePresets": [
      {
        "name": "VCPKG - Debug x86",
        "binaryDir": "${sourceDir}/build/debug",
        "inherits": "vcpkg",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "VCPKG_TARGET_TRIPLET": "x86-windows"
        },
        "environment": {
          "VCPKG_ROOT": "D:\\vcpkg"
        }
      },
      {
        "name": "VCPKG - Release x86",
        "binaryDir": "${sourceDir}/build/release",
        "inherits": "vcpkg",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "VCPKG_TARGET_TRIPLET": "x86-windows"
        },
        "environment": {
          "VCPKG_ROOT": "D:\\vcpkg"
        }
      }
    ]
  }